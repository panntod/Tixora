<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /tixora/

    # Rewrite asset CSS modul ke dalam folder pages
    RewriteRule ^(user|admin|event-owner)/(styles\.css)$ pages/$1/$2 [L]

    # Jangan rewrite file atau direktori yang sudah ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Routing API ditangani oleh /api/.htaccess
    RewriteRule ^api(?:/|$) - [L]

    # Routing halaman utama
    RewriteRule ^ index.php [L]
</IfModule>

# Nonaktifkan directory listing
Options -Indexes

