<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /tixora/ (Aktifkan baris ini hanya jika dijalankan di subfolder Laragon tanpa vhost)

    # CSS modul (/user|admin|event-owner/styles.css) dilayani oleh index.php (static file handler)

    # Jangan rewrite file atau direktori yang sudah ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Blokir akses langsung ke folder pages/
    RewriteRule ^pages(?:/|$) - [F,L]

    # Routing API ditangani oleh /api/.htaccess
    RewriteRule ^api(?:/|$) - [L]

    # Routing halaman utama
    RewriteRule ^ index.php [L]
</IfModule>

# Nonaktifkan directory listing
Options -Indexes

