<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------------------------------------
    # 1. Blokir folder sensitif SEBELUM file-serving fallthrough
    #    (agar /pages/*, /bin/*, /docker/*, dan isi backend internal
    #     tidak bisa diakses langsung dari browser)
    # ------------------------------------------------------------------
    RewriteRule ^(bin|docker)(?:/|$) - [F,L]
    RewriteRule ^pages(?:/|$) - [F,L]
    RewriteRule ^api/(config|controllers|helpers|models|migrations)(?:/|$) - [F,L]

    # ------------------------------------------------------------------
    # 2. Blokir dotfiles (.env, .env.example, .git, .htaccess, dsb)
    # ------------------------------------------------------------------
    RewriteRule (^|/)\. - [F,L]

    # ------------------------------------------------------------------
    # 3. File & direktori yang memang ada: layani langsung
    #    (assets/*.js, assets/*.png, site.webmanifest, dll)
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ------------------------------------------------------------------
    # 4. Serahkan routing API ke /api/.htaccess (yang punya aturan sendiri)
    # ------------------------------------------------------------------
    RewriteRule ^api(?:/|$) - [L]

    # ------------------------------------------------------------------
    # 5. Semua request lain → front controller
    # ------------------------------------------------------------------
    RewriteRule ^ index.php [L]
</IfModule>

# Nonaktifkan directory listing
Options -Indexes