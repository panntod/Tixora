# Database Connection (Neon PostgreSQL)
# Format dari Dashboard Neon: Pilih connection string "Direct connection" (tanpa -pooler)
# Contoh:
DATABASE_URL=postgresql://neondb_owner:npg_ganti_dengan_password_anda@ep-sample-endpoint-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Jalankan migrasi database otomatis saat container menyala (true / false)
AUTO_MIGRATE=true

# Secret Key untuk HMAC enkripsi token QR Code Tiket (minimal 32 karakter unik)
TIXORA_QR_SECRET=tixora-local-dev-secret-key-32chars

# Simulasi pembayaran (tombol "Simulasikan pembayaran berhasil"). Aktif secara bawaan selama testing.
# WAJIB diubah ke false sebelum memakai gateway pembayaran sungguhan / rilis publik.
TIXORA_PAYMENT_SANDBOX=true

# Port HTTP lokal (opsional, default: 8080 di docker compose)
PORT=80

# ---- Email (SMTP) untuk lupa kata sandi ----
# Tanpa SMTP_HOST, email TIDAK akan terkirim di server produksi. Contoh Gmail (aktifkan 2FA lalu buat "App Password"):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=email
SMTP_PASSWORD=pw
MAIL_FROM_ADDRESS=email
MAIL_FROM_NAME=Tixora