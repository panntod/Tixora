# Database Connection (Neon PostgreSQL)
# Format dari Dashboard Neon: Pilih connection string "Direct connection" (tanpa -pooler)
# Contoh:
DATABASE_URL=postgresql://neondb_owner:npg_ganti_dengan_password_anda@ep-sample-endpoint-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Jalankan migrasi database otomatis saat container menyala (true / false)
AUTO_MIGRATE=true

# Secret Key untuk HMAC enkripsi token QR Code Tiket (minimal 32 karakter unik)
TIXORA_QR_SECRET=tixora-local-dev-secret-key-32chars

# Port HTTP lokal (opsional, default: 8080 di docker compose)
PORT=80
