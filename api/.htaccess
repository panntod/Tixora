<IfModule mod_rewrite.c>
    RewriteEngine On

    # Teruskan Authorization header ke PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Jangan rewrite file atau direktori yang sudah ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Semua endpoint API diarahkan ke API router
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Nonaktifkan directory listing
Options -Indexes

# Lindungi file SQL dan konfigurasi sensitif
<FilesMatch "\.(sql|env|ini|log|bak)$">
    Require all denied
</FilesMatch>